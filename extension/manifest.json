{
  "manifest_version": 3,
  "name": "X Comment Assistant",
  "short_name": "X Comment Assistant",
  "version": "0.13.1",
  "description": "理解原帖语境，从八种回复风格中自动匹配，一次生成四条中文候选；也可手动选风格，由你挑选、编辑并发送。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://*.cn-beijing.maas.aliyuncs.com/*",
    "https://api.moonshot.cn/*",
    "https://api.moonshot.ai/*",
    "https://api.minimax.cn/*",
    "https://api.minimax.io/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://pbs.twimg.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "X Comment Assistant · 为当前推文生成回复",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "reply-style-catalog.js",
        "composer-source.js",
        "composer-ui.js",
        "composer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.deepseek.com https://api.openai.com https://dashscope.aliyuncs.com https://dashscope-intl.aliyuncs.com https://*.cn-beijing.maas.aliyuncs.com https://api.moonshot.cn https://api.moonshot.ai https://api.minimax.cn https://api.minimax.io https://ark.cn-beijing.volces.com https://pbs.twimg.com http://127.0.0.1:* http://localhost:*"
  }
}
